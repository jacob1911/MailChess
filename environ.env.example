# MailChess Environment Configuration Template
# Copy this file to environ.env and fill in your actual credentials
# DO NOT COMMIT environ.env to git (it's in .gitignore)

# Flask Secret Key (auto-generated during setup)
FLASK_SECRET_KEY=your-generated-secret-key

# Google OAuth (get from https://console.cloud.google.com/)
# Create OAuth 2.0 credentials (Desktop application)
# Add http://127.0.0.1:5000/ and http://127.0.0.1:5000/auth/callback as Authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API Key - SHARED TEAM KEY
# ⚠️  IMPORTANT: Use the shared OpenAI API key provided by the team!
# 
# This key has PAID TOKENS that are shared for development and testing.
# One of the team members paid for tokens using this key.
# 
# DO NOT create a new personal key or use your own key.
# Contact the development team if you don't have the shared key.
#
# Benefits of using the shared key:
# - No personal cost
# - All usage is tracked and attributed to the team
# - Consistent API behavior across all developers
#
# The shared key format looks like: sk-proj-[long string]
OPENAI_API_KEY=sk-proj-your-team-openai-api-key
