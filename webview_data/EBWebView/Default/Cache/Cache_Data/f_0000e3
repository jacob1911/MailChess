    // --- Slur Detection List ---
    const BAD_WORDS = [
        "idiot", "stupid", "fjols", "taber", "skod", "lort", "fuck", "sgu", "helvede"
    ];

    // Initialize Quill editor
    quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['link', 'image'],
                ['clean']
            ]
