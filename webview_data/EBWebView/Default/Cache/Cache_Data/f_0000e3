                    <strong>Opdateret!</strong> ${syncData.stats.messages_added} nye beskeder fundet.
                `;

                // Hide status after 3 seconds
                setTimeout(() => {
                    syncStatus.classList.add('hidden');
                }, 3000);
            } else {
                syncStatus.className = 'mt-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
                syncStatus.innerHTML = `
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <strong>Fejl:</strong> ${syncData.error}
                `;
            }

        } catch (error) {
            syncStatus.className = 'mt-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
            syncStatus.innerHTML = `
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Netværksfejl:</strong> ${error.message}
            `;
        } finally {
            syncBtn.disabled = false;
            syncIcon.classList.remove('fa-spin');
        }
    }

    // Update messages and board position
    async function updateThreadMessages() {
        try {
            const response = await fetch(`/api/thread/${threadId}/messages`);
            const data = await response.json();

            if (data.success) {
                // Update messages list
                const messagesContainer = document.getElementById('messagesContainer');
                let html = '';

                if (data.messages.length > 0) {
                    data.messages.forEach(msg => {
                        const isMe = msg.sender === currentUser;
                        
                        // Dark mode logic for message bubbles
                        // Me: Indigo-50 (light) / Indigo-900 (dark)
                        // Them: Gray-50 (light) / Gray-700 (dark)
                        const bgClass = isMe 
                            ? 'bg-indigo-50 dark:bg-indigo-900 border-l-4 border-indigo-500' 
                            : 'bg-gray-50 dark:bg-gray-700 border-l-4 border-gray-400 dark:border-gray-500';
                        
                        const iconClass = isMe ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-600 dark:text-gray-400';
                        const senderName = isMe ? 'Du' : msg.sender;
                        const textColor = 'text-gray-700 dark:text-gray-200';

                        const timestamp = msg.timestamp ? new Date(msg.timestamp).toLocaleString('da-DK', {
                            day: '2-digit',
                            month: '2-digit',
                            hour: '2-digit',
                            minute: '2-digit'
                        }) : '';

                        // Handle HTML vs plain text content
                        let bodyContent;
                        if (msg.is_html) {
                            // CRITICAL: Added 'email-content-inverter' class here to fix dark mode
                            bodyContent = `<div class="${textColor} message-html-content email-content-inverter" style="max-width: 100%; overflow: hidden;">${msg.body}</div>`;
                        } else {
                            bodyContent = `<p class="${textColor} whitespace-pre-wrap break-words" style="max-width: 100%; overflow-wrap: anywhere; word-break: break-word;">${msg.body}</p>`;
                        }

                        html += `
                            <div class="p-4 rounded-lg ${bgClass} break-words" style="max-width: 100%; overflow: hidden; word-wrap: break-word;">
                                <div class="flex items-start justify-between mb-2">
                                    <span class="font-semibold text-gray-800 dark:text-gray-200">
                                        <i class="fas fa-user-circle ${iconClass} mr-1"></i> ${senderName}
                                    </span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">${timestamp}</span>
                                </div>
                                ${msg.move ? `
                                    <div class="mb-2">
                                        <span class="bg-indigo-200 text-indigo-800 px-3 py-1 rounded-full text-sm font-semibold">
                                            <i class="fas fa-chess-pawn mr-1"></i>
                                            Træk: ${msg.move}
                                        </span>
                                    </div>
                                ` : ''}
                                ${bodyContent}
                            </div>
                        `;
                    });
                } else {
                    html = '<p class="text-gray-500 dark:text-gray-400 text-center py-8">Ingen beskeder endnu</p>';
                }

                messagesContainer.innerHTML = html;

                // Update chess board if FEN changed
                if (data.fen && data.fen !== game.fen()) {
                    game = new Chess(data.fen);
                    board.position(data.fen);
                }
            }
        } catch (error) {
            console.error('Error updating thread messages:', error);
        }
    }

    // Make board responsive
    window.addEventListener('resize', function () {
        if (board) {
            board.resize();
        }
    });

    // Load messages automatically when page loads
    window.addEventListener('load', function () {
        updateThreadMessages();
    });
</script>

