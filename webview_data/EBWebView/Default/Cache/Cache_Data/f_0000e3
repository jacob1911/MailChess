    // --- Real-time Slur Detection Logic ---
    quill.on('text-change', function(delta, oldDelta, source) {
        const text = quill.getText(); // Get plain text content
        const warningBox = document.getElementById('slurWarning');
        let foundSlur = false;
        
        // Normalize text: lowercase and split into words
        const words = text.toLowerCase().split(/[^a-zá-ø0-9]+/);
        
        for (const word of words) {
            if (BAD_WORDS.includes(word)) {
                foundSlur = true;
                break;
            }
        }

        if (foundSlur) {
            warningBox.classList.remove('hidden');
        } else {
            warningBox.classList.add('hidden');
        }
    });

    // Handle form submission
    document.getElementById('messageForm').addEventListener('submit', function (e) {
        // Get HTML content from Quill
        const htmlContent = quill.root.innerHTML;

        // Only submit if there's actual content (not just empty tags)
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = htmlContent;
        const textContent = tempDiv.textContent || tempDiv.innerText || '';

        if (textContent.trim().length > 0) {
            document.getElementById('messageBody').value = htmlContent;
        } else {
            document.getElementById('messageBody').value = '';
        }
    });

