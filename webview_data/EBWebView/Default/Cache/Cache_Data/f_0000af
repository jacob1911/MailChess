    <script>
        // --- LANGUAGE SWITCH FIX (AJAX API CALL + RELOAD) ---
        async function setLanguage(lang_code) {
             try {
                // 1. Call the new Flask API endpoint to update the session variable
                const response = await fetch(`http://127.0.0.1:5000/api/set_language/${lang_code}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const data = await response.json();

                if (data.success) {
                    // 2. FORCE a full page reload to fetch the new translations
                    // Adding true forces the browser to bypass its cache and request fresh content
                    window.location.reload(true); 
                } else {
                    console.error("Failed to set language:", data.error);
                }

             } catch (error) {
                 console.error("Network error during language change:", error);
                 // Fallback to absolute navigation as a last resort
                 window.location.href = `http://127.0.0.1:5000/set_language/${lang_code}`;
             }
        }
        // ----------------------------------------------------

        // --- DARK MODE LOGIC (As previously confirmed) ---

        // Function to update the icon based on the current theme
        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains('dark');
            
            // 1. Update the icon in the Navbar (navThemeIcon)
            const navIcon = document.getElementById('navThemeIcon');
            if (navIcon) {
                navIcon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }

            // 2. Update the icon in the Inbox Toolbar (themeIcon, if it exists)
            const toolbarIcon = document.getElementById('themeIcon');
            if (toolbarIcon) { 
                toolbarIcon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }

        // Function to toggle the theme
        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            
            if (isDark) {
                localStorage.setItem('theme', 'dark');
            } else {
                localStorage.setItem('theme', 'light');
            }

            // Update the icon after the theme has been toggled
            updateThemeIcon();
        }

        // Run on load
        document.addEventListener('DOMContentLoaded', updateThemeIcon);
    </script>

    
<script>
    // Global variable to store the result from the server
    let wheelOutcome = null;

    function openWheelModal() {
        const animationElement = document.getElementById('wheelAnimation');
        
        // 1. Reset and show loading state
        document.getElementById('wheelTitle').innerHTML = '<i class="fas fa-spinner fa-spin text-yellow-500 mr-2"></i> Hjulet Spinner...';
        document.getElementById('wheelResultText').classList.add('hidden');
        document.getElementById('wheelActionButton').classList.add('hidden');
        document.getElementById('wheelModal').classList.remove('hidden');

        // **START ANIMATION**
        animationElement.innerHTML = '<i class="fas fa-magic text-yellow-500"></i>';
        animationElement.classList.add('wheel-spinning'); 

        // 2. Start the spin delay (2 seconds)
        // We set the timeout duration to match the CSS animation duration (2000ms)
        setTimeout(fetchOutcomeAfterSpin, 2000); 
    }

    function closeWheelModal() {
        document.getElementById('wheelModal').classList.add('hidden');
        wheelOutcome = null; // Clear state
    }
    
    // Step 2.5: Wait for the animation to finish, then fetch the result
    async function fetchOutcomeAfterSpin() {
        const animationElement = document.getElementById('wheelAnimation');

        // Ensure the visual spin has stopped before calling the backend
        animationElement.classList.remove('wheel-spinning');
        
        // 1. Fetch outcome from backend
        try {
            const response = await fetch('/api/spin-wheel', { method: 'POST' });
            const data = await response.json();

            if (data.success) {
                wheelOutcome = data.outcome;
                const resultTextElement = document.getElementById('wheelResultText');
                
                // 2. Update the modal with the result
                document.getElementById('wheelTitle').innerHTML = '<i class="fas fa-trophy text-green-500 mr-2"></i> Skæbnen er Afgjort!';
                
                // Set animation icon/text based on action
                let icon = '';
                let color = '';
                
                if (wheelOutcome.action === 'delete') {
                    icon = '<i class="fas fa-trash-alt text-red-600"></i>';
                    color = 'text-red-600';
                } else if (wheelOutcome.action === 'label') {
                    icon = '<i class="fas fa-tag text-blue-500"></i>';
                    color = 'text-blue-500';
                } else { // No action
                    icon = '<i class="fas fa-hand-paper text-gray-500"></i>';
                    color = 'text-gray-500';
                }

                animationElement.innerHTML = icon;

                // Display the result message
                // NOTE: Translating dynamic strings like this is difficult in JS.
                // It is better to have the backend send a fully translated string for `description`.
                resultTextElement.innerHTML = `
                    Du fik: <span class="${color} font-bold">${wheelOutcome.description}</span><br>
                    Dette påvirker: <span class="font-medium">${wheelOutcome.target_count} beskeder.</span>
                `;
                resultTextElement.classList.remove('hidden');

                // Show action button if an action is required AND target count is > 0
                if (wheelOutcome.action !== 'none' && wheelOutcome.target_count > 0) {
                    document.getElementById('wheelActionButton').classList.remove('hidden');
                } else if (wheelOutcome.action !== 'none' && wheelOutcome.target_count === 0) {
                    // Specific message if the action has 0 impact
                    resultTextElement.innerHTML = `
                        Du fik: <span class="${color} font-bold">${wheelOutcome.description}</span><br>
                        <span class="text-green-500 font-bold">0 beskeder fundet. Du slipper!</span>
                    `;
                }

            } else {
                alert('Fejl ved hjulet: ' + data.error);
                closeWheelModal();
            }

        } catch (error) {
            console.error('Network Error:', error);
            alert('Netværksfejl under spin.');
            closeWheelModal();
        }
    }

    async function confirmWheelAction() {
        if (!wheelOutcome) return;

        // Show loading state while action is confirmed
        const actionButton = document.getElementById('wheelActionButton');
        actionButton.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Udfører...';
        actionButton.disabled = true;

        try {
            const response = await fetch('/api/execute-wheel-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(wheelOutcome) // Send the server's outcome back for confirmation
            });

            const data = await response.json();

            if (data.success) {
                alert(`Succes! %s beskeder blev opdateret.`.replace('%s', data.messages_affected));
                closeWheelModal();
                location.reload(); // Reload to update thread list
            } else if (data.require_reauth) {
                 alert('Authentication er påkrævet. Log venligst ud og ind igen.');
                 location.href = '/auth/logout';
            } else {
                alert('Fejl under handling: ' + data.error);
            }
        } catch (error) {
            console.error('Execution Error:', error);
            alert('Netværksfejl under handling.');
        } finally {
            actionButton.innerHTML = 'Bekræft Handling';
            actionButton.disabled = false;
        }
    }

    // Store custom labels globally
    let customLabels = [];

    async function loadContacts() {
        try {
            const response = await fetch('/api/contacts');
            const data = await response.json();

            if (data.success) {
                const dataList = document.getElementById('contactList');
                dataList.innerHTML = ''; // Clear existing

                data.contacts.forEach(email => {
                    const option = document.createElement('option');
                    option.value = email;
                    dataList.appendChild(option);
                });
            }
        } catch (error) {
            console.error('Fejl under indlæsning af kontakter:', error);
        }
    }

    function toggleNewThread() {
        const form = document.getElementById('newThreadForm');
        form.classList.toggle('hidden');
        
        // Load contacts if we are showing the form
        if (!form.classList.contains('hidden')) {
            loadContacts();
        }
    }

    function toggleLabelManager() {
        const manager = document.getElementById('labelManager');
        manager.classList.toggle('hidden');
        if (!manager.classList.contains('hidden')) {
            loadCustomLabels();
        }
    }

    // Fetch new threads
    async function fetchNewThreads() {
        const fetchBtn = document.getElementById('fetchBtn');
        const fetchIcon = document.getElementById('fetchIcon');
        const statusMessage = document.getElementById('statusMessage');
        const threadCount = document.getElementById('threadCount').value;

        // Disable button and show loading
        fetchBtn.disabled = true;
        fetchIcon.classList.add('fa-spin');

        // Show status message
        statusMessage.className = 'mb-4 p-3 rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-100';
        statusMessage.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i>Henter sidste %s tråde...`.replace('%s', threadCount);
        statusMessage.classList.remove('hidden');

        try {
            const response = await fetch('/api/fetch-threads', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ count: threadCount })
            });

            const data = await response.json();

            if (data.success) {
                const stats = data.stats;
                statusMessage.className = 'mb-4 p-3 rounded-lg bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-100';
                statusMessage.innerHTML = `
                    <i class="fas fa-check-circle mr-2"></i>
                    <strong>Hentning fuldført!</strong><br>
                    <small>
                        Nye tråde: ${stats.threads_fetched} |
                        Beskeder: ${stats.messages_added}
                    </small>
                `;

                // Update thread list
                await updateThreadList();

                // Hide after 5 seconds
                setTimeout(() => {
                    statusMessage.classList.add('hidden');
                }, 5000);

            } else {
                showError(statusMessage, data);
            }

        } catch (error) {
            statusMessage.className = 'mb-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
            statusMessage.innerHTML = `
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Netværksfejl:</strong> ${error.message}
            `;
        } finally {
            fetchBtn.disabled = false;
            fetchIcon.classList.remove('fa-spin');
        }
    }

    // Sync existing threads
    async function syncExisting() {
        const syncBtn = document.getElementById('syncBtn');
        const syncIcon = document.getElementById('syncIcon');
        const statusMessage = document.getElementById('statusMessage');

        // Disable button and show loading
        syncBtn.disabled = true;
        syncIcon.classList.add('fa-spin');

        // Show status message
        statusMessage.className = 'mb-4 p-3 rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-100';
        statusMessage.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Synkroniserer eksisterende tråde...';
        statusMessage.classList.remove('hidden');

        try {
            const response = await fetch('/api/sync-existing', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.success) {
                const stats = data.stats;
                statusMessage.className = 'mb-4 p-3 rounded-lg bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-100';
                statusMessage.innerHTML = `
                    <i class="fas fa-check-circle mr-2"></i>
                    <strong>Synkronisering fuldført!</strong><br>
                    <small>
                        Opdaterede tråde: ${stats.threads_updated} |
                        Nye beskeder: ${stats.messages_added} |
                        Træk parset: ${stats.moves_parsed}
                    </small>
                `;

                // Update thread list
                await updateThreadList();

                // Hide after 5 seconds
                setTimeout(() => {
                    statusMessage.classList.add('hidden');
                }, 5000);

            } else {
                showError(statusMessage, data);
            }

        } catch (error) {
            statusMessage.className = 'mb-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
            statusMessage.innerHTML = `
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Netværksfejl:</strong> ${error.message}
            `;
        } finally {
            syncBtn.disabled = false;
            syncIcon.classList.remove('fa-spin');
