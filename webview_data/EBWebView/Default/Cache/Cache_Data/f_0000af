    // Helper to show error messages
    function showError(element, data) {
        element.className = 'mb-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';

        if (data.require_reauth) {
            element.innerHTML = `
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <strong>Authentication fejl:</strong> ${data.error}<br>
                <button onclick="window.location.href='/auth/logout'"
                        class="mt-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded">
                    <i class="fas fa-sign-out-alt mr-2"></i>Log ud og ind igen
                </button>
            `;
        } else {
            element.innerHTML = `
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Fejl:</strong> ${data.error}
            `;
        }
    }

    // Load custom labels
    async function loadCustomLabels() {
        try {
            const response = await fetch('/api/custom-labels');
            const data = await response.json();

            if (data.success) {
                customLabels = data.labels;
                renderCustomLabelsList();
                updateLabelFilter();
            }
        } catch (error) {
            console.error('Fejl under indlæsning af brugerdefinerede labels:', error);
        }
    }

    // Render custom labels list in manager
    function renderCustomLabelsList() {
        const container = document.getElementById('customLabelsList');

        if (customLabels.length === 0) {
            container.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-sm">Ingen brugerdefinerede labels endnu</p>';
            return;
        }

        let html = '';
        customLabels.forEach(label => {
            const iconHtml = label.icon_path
                ? `<img src="${label.icon_path}" alt="${label.display_name}" class="w-5 h-5">`
                : `<i class="fas fa-tag"></i>`;

            html += `
                <div class="flex items-center justify-between p-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg">
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 rounded flex items-center justify-center" style="background-color: ${label.color}22; color: ${label.color};">
                            ${iconHtml}
                        </div>
                        <div>
                            <p class="font-medium text-gray-800 dark:text-white">${label.display_name}</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">${label.name}</p>
                        </div>
                    </div>
                    <button onclick="deleteCustomLabel(${label.id}, '${label.display_name}')"
                            class="text-red-500 hover:text-red-700 p-2">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    // Update label filter dropdown with custom labels
    function updateLabelFilter() {
        const filterSelect = document.getElementById('labelFilter');

        // Remove existing custom label options
        const options = Array.from(filterSelect.options);
        options.forEach(option => {
            if (option.dataset.custom === 'true') {
                option.remove();
            }
        });

        // Add custom labels
        customLabels.forEach(label => {
            const option = document.createElement('option');
            option.value = label.name;
            option.textContent = label.display_name;
            option.dataset.custom = 'true';
            filterSelect.appendChild(option);
        });
    }

    // Create custom label
    document.getElementById('createLabelForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();

        const name = document.getElementById('labelName').value;
        const color = document.getElementById('labelColor').value;
        const iconFile = document.getElementById('labelIcon').files[0];

        const formData = new FormData();
        formData.append('display_name', name);
        formData.append('color', color);
        if (iconFile) {
            formData.append('icon', iconFile);
        }

        try {
            const response = await fetch('/api/custom-labels', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                alert(`Label &#34;%s&#34; oprettet!`.replace('%s', data.label.display_name));
                document.getElementById('createLabelForm').reset();
                document.getElementById('labelColor').value = '#6B7280';
                await loadCustomLabels();
            } else {
                alert('Fejl: ' + data.error);
            }
        } catch (error) {
            console.error('Fejl under oprettelse af label:', error);
            alert('Netværksfejl: ' + error.message);
        }
    });

    // Delete custom label
    async function deleteCustomLabel(labelId, labelName) {
        if (!confirm(`Er du sikker på at du vil slette labelet &#34;%s&#34;?`.replace('%s', labelName))) {
            return;
        }

        try {
            const response = await fetch(`/api/custom-labels/${labelId}`, {
                method: 'DELETE'
            });

            const data = await response.json();

            if (data.success) {
                alert(data.message);
                await loadCustomLabels();
                await updateThreadList();
            } else {
                alert('Fejl: ' + data.error);
            }
        } catch (error) {
            console.error('Fejl under sletning af label:', error);
            alert('Netværksfejl: ' + error.message);
        }
    }

    // Helper function to render label badges
    function renderLabelBadges(labels) {
        if (!labels || labels.length === 0) return '';

        const labelIcons = {
            'UNREAD': '<i class="fas fa-envelope"></i>',
            'STARRED': '<i class="fas fa-star"></i>',
            'IMPORTANT': '<i class="fas fa-exclamation"></i>',
            'INBOX': '<i class="fas fa-inbox"></i>'
        };

        return labels.map(label => {
            // Check if it's a custom label
            const customLabel = customLabels.find(cl => cl.name === label);

            if (customLabel) {
                const iconHtml = customLabel.icon_path
                    ? `<img src="${customLabel.icon_path}" alt="${customLabel.display_name}" style="width: 12px; height: 12px;">`
                    : `<i class="fas fa-tag"></i>`;
                return `<span class="label-badge" style="background-color: ${customLabel.color}22; color: ${customLabel.color}; border: 1px solid ${customLabel.color}">${iconHtml}</span>`;
            } else {
                // System label
                const icon = labelIcons[label] || label;
                const labelClass = `label-${label.toLowerCase()}`;
                return `<span class="label-badge ${labelClass}">${icon}</span>`;
            }
        }).join('');
    }

    // Update thread list after sync
    async function updateThreadList() {
        try {
            const response = await fetch('/api/threads');
            const data = await response.json();

            if (data.success && data.threads.length > 0) {
                const threadsList = document.getElementById('threadsList');

                // Build new thread list HTML
                let html = '<div class="space-y-2">';
                data.threads.forEach(thread => {
                    const labelBadges = renderLabelBadges(thread.labels);
                    const labelData = thread.labels ? thread.labels.join(',') : '';

                    // Format timestamp
                    let timestamp = '';
                    if (thread.last_updated) {
                        const date = new Date(thread.last_updated);
                        const day = String(date.getDate()).padStart(2, '0');
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const year = String(date.getFullYear()).slice(-2);
                        const hours = String(date.getHours()).padStart(2, '0');
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        timestamp = `${day}/${month}/${year} ${hours}:${minutes}`;
                    }

                    // Format other person (username part before @)
                    let otherPersonName = '';
                    if (thread.other_person) {
                        otherPersonName = thread.other_person.split('@')[0];
                    }

                    // Format snippet with person name
                    let snippetText = thread.snippet ?
                        (thread.snippet.length > 40 ? thread.snippet.substring(0, 40) + '...' : thread.snippet) :
                        'Ingen beskeder endnu'; // Localization here

                    let snippetHtml = otherPersonName ?
                        `<span class="font-medium text-gray-900 dark:text-gray-300">${otherPersonName}</span> - ${snippetText}` :
                        snippetText;

                    html += `
                        <div class="relative group thread-item" data-labels="${labelData}">
                            <a href="/thread/${thread.id}"
                               class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-700 transition duration-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-3 flex-1">
                                        <div class="bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-200 rounded-full w-10 h-10 flex items-center justify-center">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-1">
                                                <div class="flex items-center space-x-2">
                                                    <p class="font-semibold text-gray-800 dark:text-gray-200">${thread.subject}</p>
                                                    <div class="flex space-x-1">
                                                        ${labelBadges}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <p class="text-sm text-gray-600 dark:text-gray-400">${snippetHtml}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center space-x-3">
                                        <span class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">${timestamp}</span>
                                        <i class="fas fa-chevron-right text-gray-400"></i>
                                    </div>
                                </div>
                            </a>
                            <div class="absolute top-2 right-2 hidden group-hover:flex space-x-1 bg-white dark:bg-gray-700 rounded-lg shadow-md p-1 border dark:border-gray-600">
                                <button onclick="toggleLabel(event, ${thread.id}, 'STARRED')"
                                        class="p-2 hover:bg-yellow-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Stjerne">
                                    <i class="fas fa-star text-yellow-500"></i>
                                </button>
                                <button onclick="toggleLabel(event, ${thread.id}, 'IMPORTANT')"
                                        class="p-2 hover:bg-red-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Vigtig">
                                    <i class="fas fa-exclamation text-red-500"></i>
                                </button>
                                <button onclick="markAsRead(event, ${thread.id})"
                                        class="p-2 hover:bg-blue-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Marker som læst">
                                    <i class="fas fa-envelope-open text-blue-500"></i>
                                </button>
                                <div class="relative">
                                    <button onclick="toggleCustomLabelMenu(event, ${thread.id})"
                                            class="p-2 hover:bg-purple-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                            title="Brugerdefinerede labels">
                                        <i class="fas fa-tags text-purple-500"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';

                threadsList.innerHTML = html;

                // Apply current filter if any
                filterThreads();
            } else if (data.success && data.threads.length === 0) {
                const threadsList = document.getElementById('threadsList');
                threadsList.innerHTML = `
                    <div class="text-center py-12 text-gray-500 dark:text-gray-400">
                        <i class="fas fa-inbox text-6xl mb-4 opacity-50"></i>
                        <p class="text-lg">Ingen tråde endnu</p>
                        <p class="text-sm">Opret en ny tråd for at komme i gang!</p>
                    </div>
                `;
            }
        } catch (error) {
            console.error('Fejl under opdatering af trådliste:', error);
        }
    }

    // Clear database
    async function clearDatabase() {
        // Confirm before clearing
        if (!confirm('Er du sikker på at du vil rydde HELE databasen? Dette vil slette alle tråde, beskeder og spil permanent!')) {
            return;
        }

        const clearBtn = document.getElementById('clearBtn');
        const clearIcon = document.getElementById('clearIcon');
        const statusMessage = document.getElementById('statusMessage');

        // Disable button and show loading
        clearBtn.disabled = true;
        clearIcon.classList.add('fa-spin');

        // Show status message
        statusMessage.className = 'mb-4 p-3 rounded-lg bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-100';
        statusMessage.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Rydder database...';
        statusMessage.classList.remove('hidden');

        try {
            const response = await fetch('/api/clear-database', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.success) {
                const stats = data.stats;
                statusMessage.className = 'mb-4 p-3 rounded-lg bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-100';
                statusMessage.innerHTML = `
                    <i class="fas fa-check-circle mr-2"></i>
                    <strong>Database ryddet!</strong><br>
                    <small>
                        Tråde slettet: ${stats.threads_deleted} |
                        Beskeder slettet: ${stats.messages_deleted} |
                        Spil slettet: ${stats.games_deleted}
                    </small>
                `;

                // Clear thread list display
                const threadsList = document.getElementById('threadsList');
                threadsList.innerHTML = `
                    <div class="text-center py-12 text-gray-500 dark:text-gray-400">
                        <i class="fas fa-inbox text-6xl mb-4 opacity-50"></i>
                        <p class="text-lg">Ingen tråde endnu</p>
                        <p class="text-sm">Opret en ny tråd for at komme i gang!</p>
                    </div>
                `;

                // Hide after 5 seconds
                setTimeout(() => {
                    statusMessage.classList.add('hidden');
                }, 5000);

            } else {
                statusMessage.className = 'mb-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
                statusMessage.innerHTML = `
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <strong>Fejl:</strong> ${data.error}
                `;
            }

        } catch (error) {
            statusMessage.className = 'mb-4 p-3 rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-100';
            statusMessage.innerHTML = `
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Netværksfejl:</strong> ${error.message}
            `;
        } finally {
            clearBtn.disabled = false;
            clearIcon.classList.remove('fa-spin');
        }
    }

    // Filter threads by label
    function filterThreads() {
        const filterValue = document.getElementById('labelFilter');
        const threadItems = document.querySelectorAll('.thread-item');

        threadItems.forEach(item => {
            if (!filterValue.value) {
                // Show all threads if no filter selected
                item.style.display = '';
            } else {
                // Check if thread has the selected label
                const labels = item.getAttribute('data-labels');
                if (labels && labels.split(',').includes(filterValue.value)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            }
        });
    }

    // Toggle a label for a thread
    async function toggleLabel(event, threadId, label) {
        console.log('[DEBUG] toggleLabel called', { threadId, label });
        event.preventDefault();
        event.stopPropagation();

        // Find thread item - try closest first, then search by thread link
        let threadItem = event.target.closest('.thread-item');
        if (!threadItem) {
            // If called from dropdown menu, find thread by ID in the link
            const threadLink = document.querySelector(`a[href="/thread/${threadId}"]`);
            if (threadLink) {
                threadItem = threadLink.closest('.thread-item');
            }
        }

        if (!threadItem) {
            console.error('[ERROR] Kunne ikke finde tråd-element for threadId:', threadId);
            alert('Kunne ikke finde tråden');
            return;
        }

        const labels = threadItem.getAttribute('data-labels').split(',').filter(l => l);
        const hasLabel = labels.includes(label);
        console.log('[DEBUG] Current labels:', labels, 'Has label:', hasLabel);

        try {
            const requestBody = {
                add_labels: hasLabel ? [] : [label],
                remove_labels: hasLabel ? [label] : []
            };
            console.log('[DEBUG] Sending request:', requestBody);

            const response = await fetch(`/api/thread/${threadId}/labels`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestBody)
            });

            const data = await response.json();
            console.log('[DEBUG] Response:', data);

            if (data.success) {
                // Refresh thread list to show updated labels
                await updateThreadList();
            } else if (data.require_reauth) {
                alert(data.error);
                window.location.href = '/auth/logout';
            } else {
                alert('Fejl: ' + data.error);
            }
        } catch (error) {
            console.error('Fejl under skift af label:', error);
            alert('Netværksfejl: ' + error.message);
        }
    }

    // Mark thread as read
    async function markAsRead(event, threadId) {
        event.preventDefault();
        event.stopPropagation();

        try {
            const response = await fetch(`/api/thread/${threadId}/labels`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    add_labels: [],
                    remove_labels: ['UNREAD']
                })
            });

            const data = await response.json();

            if (data.success) {
                // Refresh thread list to show updated labels
                await updateThreadList();
            } else if (data.require_reauth) {
                alert(data.error);
                window.location.href = '/auth/logout';
            } else {
                alert('Fejl: ' + data.error);
            }
        } catch (error) {
            console.error('Fejl under markering som læst:', error);
            alert('Netværksfejl: ' + error.message);
        }
    }

    // Toggle custom label menu
    let currentLabelMenuThreadId = null;
    function toggleCustomLabelMenu(event, threadId) {
        console.log('[DEBUG] toggleCustomLabelMenu called', { threadId, customLabelsCount: customLabels.length });
        event.preventDefault();
        event.stopPropagation();

        // Remove existing menu if any
        const existingMenu = document.getElementById('customLabelMenu');
        if (existingMenu) {
            existingMenu.remove();
        }

        // If clicking same thread, just close
        if (currentLabelMenuThreadId === threadId) {
            currentLabelMenuThreadId = null;
            return;
        }

        currentLabelMenuThreadId = threadId;

        // Create menu
        const menu = document.createElement('div');
        menu.id = 'customLabelMenu';
        menu.className = 'absolute top-full right-0 mt-1 bg-white dark:bg-gray-700 rounded-lg shadow-lg p-2 z-50 min-w-48 border dark:border-gray-600';
        menu.style.maxHeight = '300px';
        menu.style.overflowY = 'auto';

        if (customLabels.length === 0) {
            console.log('[DEBUG] Ingen brugerdefinerede labels tilgængelige');
            menu.innerHTML = '<p class="text-gray-500 dark:text-gray-400 text-xs p-2">Ingen brugerdefinerede labels</p>';
        } else {
            console.log('[DEBUG] Opretter menu med labels:', customLabels);
            customLabels.forEach(label => {
                const iconHtml = label.icon_path
                    ? `<img src="${label.icon_path}" alt="${label.display_name}" style="width: 14px; height: 14px;">`
                    : `<i class="fas fa-tag"></i>`;

                const btn = document.createElement('button');
                btn.className = 'w-full flex items-center space-x-2 p-2 hover:bg-gray-100 dark:hover:bg-gray-600 rounded text-left text-sm text-gray-800 dark:text-white';
                btn.innerHTML = `
                    <div class="w-6 h-6 rounded flex items-center justify-center" style="background-color: ${label.color}22; color: ${label.color};">
                        ${iconHtml}
                    </div>
                    <span>${label.display_name}</span>
                `;
                btn.onclick = (e) => {
                    console.log('[DEBUG] Brugerdefineret label-knap klikket:', label.name);
                    e.stopPropagation();
                    toggleLabel(e, threadId, label.name);
                    menu.remove();
                    currentLabelMenuThreadId = null;
                };
                menu.appendChild(btn);
            });
        }

        event.target.closest('.relative').appendChild(menu);
        console.log('[DEBUG] Menu tilføjet til DOM');

        // Close menu when clicking elsewhere
        setTimeout(() => {
            document.addEventListener('click', function closeMenu() {
                const menu = document.getElementById('customLabelMenu');
                if (menu) {
                    menu.remove();
                }
                currentLabelMenuThreadId = null;
                document.removeEventListener('click', closeMenu);
            }, 100);
        });
    }

    // Load custom labels on page load
    window.addEventListener('DOMContentLoaded', function () {
        loadCustomLabels();
    });

</script>

