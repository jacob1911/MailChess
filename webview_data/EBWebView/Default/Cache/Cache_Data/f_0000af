                </button>
                <button type="button" onclick="toggleNewThread()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold px-6 py-2 rounded-lg transition duration-200">
                    Annuller
                </button>
            </div>
        </form>
    </div>

