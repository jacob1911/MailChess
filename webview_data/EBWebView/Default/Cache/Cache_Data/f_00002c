    <style>
        /* This fixes the email display in Dark Mode */
        .dark .email-content-inverter {
            filter: invert(1) hue-rotate(180deg);
        }
        .dark .email-content-inverter img {
            filter: invert(1) hue-rotate(180deg);
        }
        
        /* Smooth transition for theme switching */
        html, body { transition: background-color 0.3s, color 0.3s; }

        /* --- NEW WHEEL ANIMATION CSS --- */
        @keyframes spin-wheel-keyframes {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(720deg); } /* Spins 2 full times */
        }

        .wheel-spinning {
            animation: spin-wheel-keyframes 2s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards; 
        }
        /* -------------------------------- */
    </style>

    
<style>
    .label-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
    }
    .label-unread { background-color: #DBEAFE; color: #1E40AF; }
    .label-starred { background-color: #FEF3C7; color: #D97706; }
    .label-important { background-color: #FEE2E2; color: #DC2626; }
    .label-inbox { background-color: #DCFCE7; color: #16A34A; }

    /* Video Intro Styles */
    #videoIntroOverlay {
        opacity: 1;
        transition: opacity 0.8s ease-out;
    }

    #videoIntroOverlay.fade-out {
        opacity: 0;
        pointer-events: none;
    }

    #introVideo {
        object-fit: contain;
    }

    /* Mobile responsiveness */
    @media (max-width: 768px) {
        #introVideo {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
        }
    }
</style>


