    async function deleteCustomLabel(labelId, labelName) {
        if (!confirm(`Er du sikker på at du vil slette labelet "%s"?`.replace('%s', labelName))) {
            return;
        }

        try {
            const response = await fetch(`/api/custom-labels/${labelId}`, {
