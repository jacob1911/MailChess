                            ${iconHtml}
                        </div>
                        <div>
                            <p class="font-medium text-gray-800 dark:text-white">${label.display_name}</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">${label.name}</p>
                        </div>
                    </div>
                    <button onclick="deleteCustomLabel(${label.id}, '${label.display_name}')"
