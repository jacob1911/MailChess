                    const labelBadges = renderLabelBadges(thread.labels);
                    const labelData = thread.labels ? thread.labels.join(',') : '';

                    // Format timestamp
                    let timestamp = '';
                    if (thread.last_updated) {
                        const date = new Date(thread.last_updated);
                        const day = String(date.getDate()).padStart(2, '0');
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const year = String(date.getFullYear()).slice(-2);
                        const hours = String(date.getHours()).padStart(2, '0');
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        timestamp = `${day}/${month}/${year} ${hours}:${minutes}`;
                    }

                    // Format other person (username part before @)
                    let otherPersonName = '';
                    if (thread.other_person) {
                        otherPersonName = thread.other_person.split('@')[0];
                    }

                    // Format snippet with person name
                    let snippetText = thread.snippet ?
                        (thread.snippet.length > 40 ? thread.snippet.substring(0, 40) + '...' : thread.snippet) :
                        'Ingen beskeder endnu';

                    let snippetHtml = otherPersonName ?
                        `<span class="font-medium text-gray-900 dark:text-gray-300">${otherPersonName}</span> - ${snippetText}` :
                        snippetText;

                    html += `
                        <div class="relative group thread-item" data-labels="${labelData}">
                            <a href="/thread/${thread.id}"
                               class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-indigo-50 dark:hover:bg-gray-700 transition duration-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-3 flex-1">
                                        <div class="bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-200 rounded-full w-10 h-10 flex items-center justify-center">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-1">
                                                <div class="flex items-center space-x-2">
                                                    <p class="font-semibold text-gray-800 dark:text-gray-200">${thread.subject}</p>
                                                    <div class="flex space-x-1">
                                                        ${labelBadges}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <p class="text-sm text-gray-600 dark:text-gray-400">${snippetHtml}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center space-x-3">
                                        <span class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">${timestamp}</span>
                                        <i class="fas fa-chevron-right text-gray-400"></i>
                                    </div>
                                </div>
                            </a>
                            <div class="absolute top-2 right-2 hidden group-hover:flex space-x-1 bg-white dark:bg-gray-700 rounded-lg shadow-md p-1 border dark:border-gray-600">
                                <button onclick="toggleLabel(event, ${thread.id}, 'STARRED')"
                                        class="p-2 hover:bg-yellow-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Stjerne">
                                    <i class="fas fa-star text-yellow-500"></i>
                                </button>
                                <button onclick="toggleLabel(event, ${thread.id}, 'IMPORTANT')"
                                        class="p-2 hover:bg-red-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Vigtig">
                                    <i class="fas fa-exclamation text-red-500"></i>
                                </button>
                                <button onclick="markAsRead(event, ${thread.id})"
                                        class="p-2 hover:bg-blue-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                        title="Marker som læst">
                                    <i class="fas fa-envelope-open text-blue-500"></i>
                                </button>
                                <div class="relative">
                                    <button onclick="toggleCustomLabelMenu(event, ${thread.id})"
                                            class="p-2 hover:bg-purple-50 dark:hover:bg-gray-600 rounded transition duration-200"
                                            title="Custom labels">
                                        <i class="fas fa-tags text-purple-500"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';

                threadsList.innerHTML = html;

                // Apply current filter if any
                filterThreads();
            } else if (data.success && data.threads.length === 0) {
                const threadsList = document.getElementById('threadsList');
                threadsList.innerHTML = `
                    <div class="text-center py-12 text-gray-500 dark:text-gray-400">
                        <i class="fas fa-inbox text-6xl mb-4 opacity-50"></i>
                        <p class="text-lg">Ingen tråde endnu</p>
                        <p class="text-sm">Opret en ny tråd for at komme i gang!</p>
                    </div>
                `;
            }
        } catch (error) {
            console.error('Error updating thread list:', error);
        }
    }

    // --- VIDEO INTRO LOGIC ---
    (function() {
        // Check if video has been shown this session
        const videoShown = sessionStorage.getItem('videoIntroShown');

        if (!videoShown) {
            // Get elements
            const overlay = document.getElementById('videoIntroOverlay');
            const video = document.getElementById('introVideo');

            if (overlay && video) {
                // Show the overlay
                overlay.classList.remove('hidden');

                // Set sessionStorage flag immediately to prevent re-showing on refresh
                sessionStorage.setItem('videoIntroShown', 'true');

                // Handle video end event
                video.addEventListener('ended', function() {
                    fadeOutAndHide();
                });

                // Handle video error
                video.addEventListener('error', function(e) {
                    console.error('Video failed to load:', e);
                    // Hide overlay immediately on error
                    overlay.classList.add('hidden');
                });

                // Fade out function
                function fadeOutAndHide() {
                    // Add fade-out class
                    overlay.classList.add('fade-out');

                    // After transition completes, hide the overlay completely
                    setTimeout(function() {
                        overlay.classList.add('hidden');
                    }, 800); // Match the CSS transition duration
                }
            }
        }
    })();
</script>

</body>
</html>