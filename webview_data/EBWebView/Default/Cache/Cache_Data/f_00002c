                </div>
            `;
        });

        container.innerHTML = html;
    }

    // Update label filter dropdown with custom labels
    function updateLabelFilter() {
        const filterSelect = document.getElementById('labelFilter');

        // Remove existing custom label options
        const options = Array.from(filterSelect.options);
        options.forEach(option => {
            if (option.dataset.custom === 'true') {
                option.remove();
            }
        });

        // Add custom labels
        customLabels.forEach(label => {
            const option = document.createElement('option');
            option.value = label.name;
            option.textContent = label.display_name;
            option.dataset.custom = 'true';
            filterSelect.appendChild(option);
        });
    }

    // Create custom label
    document.getElementById('createLabelForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();

        const name = document.getElementById('labelName').value;
        const color = document.getElementById('labelColor').value;
        const iconFile = document.getElementById('labelIcon').files[0];

        const formData = new FormData();
        formData.append('display_name', name);
        formData.append('color', color);
        if (iconFile) {
            formData.append('icon', iconFile);
        }

        try {
            const response = await fetch('/api/custom-labels', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                alert(`Label "%s" oprettet!`.replace('%s', data.label.display_name));
